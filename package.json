{
  "name": "ewolucja",
  "version": "0.2.0",
  "private": true,
  "description": "Turowa gra strategiczna o doborze naturalnym i historii życia — przeglądarkowa, dla młodzieży i dorosłych.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node test/engine.test.js && node --experimental-strip-types --no-warnings test/creature.test.mjs",
    "shots": "node scripts/screenshots.mjs",
    "visual": "node scripts/visual-check.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "pixi.js": "^8.21.0"
  }
}
